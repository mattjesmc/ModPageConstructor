{#
  HTML macros for the CurseForge description editor. CurseForge sanitises the
  markup it is given, so this sticks to the tags it reliably keeps: headings,
  paragraphs with align, images, links, tables, lists and rules. No inline CSS,
  no <details>.
#}

{%- macro link(item) -%}
{% if item.url %}<a href="{{ item.url }}">{{ item.name | e }}</a>{% else %}{{ item.name | e }}{% endif %}
{%- endmacro -%}

{% macro section_header(section) %}
{% if section.banner %}
<p align="center"><a id="{{ section.id }}"></a><img src="{{ asset(section.banner) }}" alt="{{ section.title }}"{% if header.section_banner_width %} width="{{ header.section_banner_width }}"{% endif %}></p>
{% if header.heading_with_banner %}
<h2 id="{{ section.id }}-heading">{{ section.title }}</h2>
{% endif %}
{% else %}
<h2 id="{{ section.id }}">{{ section.title }}</h2>
{% endif %}
{% endmacro %}

{#- CurseForge's sanitiser may drop the ids these links point at; the list is
    still worth having as an overview of the page. -#}
{% macro contents() %}
{% if toc %}
<hr>
{% if toc.banner %}
<p align="center"><a id="{{ toc.id }}"></a><img src="{{ asset(toc.banner) }}" alt="{{ toc.title or 'Contents' }}"{% if header.section_banner_width %} width="{{ header.section_banner_width }}"{% endif %}></p>
{% if toc.title and header.heading_with_banner %}
<h2>{{ toc.title }}</h2>
{% endif %}
{% elif toc.title %}
<h2 id="{{ toc.id }}">{{ toc.title }}</h2>
{% endif %}
{% if toc.style == 'inline' %}
<p align="center">
{% for entry in toc.entries %}<a href="#{{ entry.id }}">{{ entry.title | e }}</a>{% if not loop.last %} &bull; {% endif %}{% endfor %}
</p>
{% else %}
{% if toc.numbered %}
<ol>
{% else %}
<ul>
{% endif %}
{% for entry in toc.entries %}
<li><a href="#{{ entry.id }}">{{ entry.title | e }}</a></li>
{% endfor %}
{% if toc.numbered %}
</ol>
{% else %}
</ul>
{% endif %}
{% endif %}
{% endif %}
{% endmacro %}

{% macro page_header() %}
{% if header.banner %}
<p align="center"><img src="{{ asset(header.banner) }}" alt="{{ cfg.name | e }}"{% if header.width %} width="{{ header.width }}"{% endif %}></p>
{% endif %}
{% if header.show_title %}
<h1 align="center">{{ cfg.name | e }}</h1>
{% endif %}
{% if cfg.tagline %}
<p align="center"><em>{{ cfg.tagline | e }}</em></p>
{% endif %}
{% if badges %}
<p align="center">
{% for badge in badges %}
{% if badge.url %}<a href="{{ badge.url }}"><img src="{{ badge.image }}" alt="{{ badge.alt }}"></a>{% else %}<img src="{{ badge.image }}" alt="{{ badge.alt }}">{% endif %}&nbsp;
{% endfor %}
</p>
{% endif %}
{% if minecraft.loaders or minecraft.versions or minecraft.environment %}
<p align="center">
{% if minecraft.loaders %}<strong>Loaders:</strong> {{ minecraft.loaders | join(', ') | e }}{% if minecraft.versions or minecraft.environment %} &bull; {% endif %}{% endif %}
{% if minecraft.versions %}<strong>Minecraft:</strong> {{ minecraft.versions | join(', ') | e }}{% if minecraft.environment %} &bull; {% endif %}{% endif %}
{% if minecraft.environment %}<strong>Side:</strong> {{ minecraft.environment | e }}{% endif %}
</p>
{% endif %}
{% endmacro %}

{% macro body(section) %}
{% if section.body %}
{{ section.body | md }}
{% endif %}
{% endmacro %}

{% macro features(section) %}
{{ body(section) }}
{% set plain = section.data['items'] | rejectattr('image', 'defined') | list %}
{% if plain | length == section.data['items'] | length %}
<ul>
{% for item in section.data['items'] %}
<li><strong>{{ item.title | e }}</strong>{% if item.description %} &mdash; {{ item.description | inline_md }}{% endif %}</li>
{% endfor %}
</ul>
{% else %}
{% for item in section.data['items'] %}
{% if item.image %}
<p align="center"><img src="{{ asset(item.image) }}" alt="{{ item.title | e }}"></p>
{% endif %}
<p><strong>{{ item.title | e }}</strong>{% if item.description %}<br>{{ item.description | inline_md }}{% endif %}</p>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro gallery(section) %}
{{ body(section) }}
{% for img in section.data['images'] %}
<p align="center"><img src="{{ asset(img.src) }}" alt="{{ img.alt or img.caption or cfg.name }}"{% if img.width %} width="{{ img.width }}"{% endif %}>
{% if img.caption %}
<br><sub><em>{{ img.caption | e }}</em></sub>
{% endif %}
</p>
{% endfor %}
{% endmacro %}

{% macro dep_table(title, items) %}
<p><strong>{{ title }}</strong></p>
<table>
<tr><th>Mod</th><th>Version</th><th>Notes</th></tr>
{% for item in items %}
<tr><td>{{ link(item) }}</td><td>{{ (item.version or item.versions) | e or '&mdash;' }}</td><td>{{ (item.note or item.notes or '') | e }}</td></tr>
{% endfor %}
</table>
{% endmacro %}

{% macro dependencies(section) %}
{{ body(section) }}
{% if section.data['required'] or section.data['optional'] or section.data['bundled'] %}
{% if section.data['required'] %}
{{ dep_table('Required', section.data['required']) }}
{% endif %}
{% if section.data['optional'] %}
{{ dep_table('Optional', section.data['optional']) }}
{% endif %}
{% if section.data['bundled'] %}
{{ dep_table('Bundled (no download needed)', section.data['bundled']) }}
{% endif %}
{% elif not section.body %}
{{ section.empty_text | md }}
{% endif %}
{% endmacro %}

{% macro incompatibilities(section) %}
{{ body(section) }}
{% if section.data['known'] %}
<table>
<tr><th>Mod</th><th>Conflict</th><th>Workaround</th></tr>
{% for item in section.data['known'] %}
<tr><td>{{ link(item) }}</td><td>{{ (item.reason or item.note) | e or '&mdash;' }}</td><td>{{ item.workaround | e or '&mdash;' }}</td></tr>
{% endfor %}
</table>
{% elif not section.body %}
{{ section.empty_text | md }}
{% endif %}
{% endmacro %}

{% macro faq(section) %}
{{ body(section) }}
{% for item in section.data['items'] %}
<p><strong>{{ item.question | e }}</strong><br>{{ item.answer | inline_md }}</p>
{% endfor %}
{% endmacro %}

{% macro recipes(section) %}
{{ body(section) }}
{% set opts = section.data['options'] %}
{% set columns = opts.get('columns', 3) %}
{% if section.data['images'] %}
<table>
{% for row in section.data['images'] | batch(columns) %}
<tr>
{% for image in row %}
<td align="center"><img src="{{ asset(image.relative) }}" alt="{{ image.recipe.type_label }} recipe for {{ image.recipe.display | e }}"><br><sub>{{ image.recipe.display | e }}{% if image.recipe.type != 'minecraft:crafting_shaped' %} <em>({{ image.recipe.type_label }})</em>{% endif %}</sub></td>
{% endfor %}
</tr>
{% endfor %}
</table>
{% elif not section.body %}
{{ section.empty_text | md }}
{% endif %}
{% endmacro %}


{#- Generated elements, in the tags CurseForge's sanitiser keeps. No <details>
    here either, so a collapsed section is simply shown in full. -#}

{%- macro element_title(item) -%}
{% if item.url %}<a href="{{ item.url }}">{{ item.title | e }}</a>{% else %}{{ item.title | e }}{% endif %}
{%- endmacro -%}

{% macro elements_list(items) %}
<ul>
{% for item in items %}
<li><strong>{{ element_title(item) }}</strong>{% if item.description %} &mdash; {{ item.description | inline_md }}{% endif %}
{% if item['items'] %}
<ul>
{% for child in item['items'] %}
<li><strong>{{ element_title(child) }}</strong>{% if child.description %} &mdash; {{ child.description | inline_md }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</li>
{% endfor %}
</ul>
{% endmacro %}

{% macro elements_definition(items) %}
{% for item in items %}
<p><strong>{{ element_title(item) }}</strong>{% if item.date %} <sub>{{ item.date }}</sub>{% endif %}{% if item.description %}<br>{{ item.description | inline_md }}{% endif %}</p>
{% endfor %}
{% endmacro %}

{% macro elements_cards(items) %}
{% for item in items %}
{% if item.image or item.src %}
<p align="center"><img src="{{ asset(item.image or item.src) }}" alt="{{ item.title | e }}"></p>
{% endif %}
<p><strong>{{ element_title(item) }}</strong>{% if item.description %}<br>{{ item.description | inline_md }}{% endif %}</p>
{% endfor %}
{% endmacro %}

{% macro elements_gallery(items) %}
{% for item in items %}
<p align="center"><img src="{{ asset(item.image or item.src) }}" alt="{{ item.alt or item.title or cfg.name }}"{% if item.width %} width="{{ item.width }}"{% endif %}>
{% if item.caption or item.description %}
<br><sub><em>{{ (item.caption or item.description) | e }}</em></sub>
{% endif %}
</p>
{% endfor %}
{% endmacro %}

{% macro elements_table(section) %}
{% set columns = section.data['columns'] %}
<table>
<tr>{% for column in columns %}<th>{{ column.title | e }}</th>{% endfor %}</tr>
{% for item in section.data['elements'] %}
<tr>{% for column in columns %}<td>{{ item[column.field] if item[column.field] is not none else '' }}</td>{% endfor %}</tr>
{% endfor %}
</table>
{% endmacro %}

{% macro changelog_release(release) %}
<p><strong>{{ element_title(release) }}</strong>{% if release.date %} <sub>{{ release.date }}</sub>{% endif %}</p>
{% if release.body %}
{{ release.body | md }}
{% endif %}
{% for group in release['groups'] or [] %}
{% if group.title %}
<p><em>{{ group.title | e }}</em></p>
{% endif %}
<ul>
{% for change in group['items'] %}
<li>{{ change.title | e }}{% if change.url and change.short %} (<a href="{{ change.url }}"><code>{{ change.short }}</code></a>){% endif %}</li>
{% endfor %}
</ul>
{% endfor %}
{% if not release['groups'] and release.description %}
{{ release.description | md }}
{% endif %}
{% endmacro %}

{% macro elements(section) %}
{% if section.layout == 'table' %}
{{ elements_table(section) }}
{% elif section.layout == 'changelog' %}
{% for release in section.data['elements'] %}
{{ changelog_release(release) }}
{% endfor %}
{% elif section.layout == 'cards' %}
{{ elements_cards(section.data['elements']) }}
{% elif section.layout in ('gallery', 'slider') %}
{{ elements_gallery(section.data['elements']) }}
{% elif section.layout == 'definition' %}
{{ elements_definition(section.data['elements']) }}
{% else %}
{{ elements_list(section.data['elements']) }}
{% endif %}
{% endmacro %}

{% macro section_body(section) %}
{% if section.id == 'dependencies' %}
{{ dependencies(section) }}
{% elif section.id == 'incompatibilities' %}
{{ incompatibilities(section) }}
{% elif section.id == 'features' %}
{{ features(section) }}
{% elif section.id == 'gallery' %}
{{ gallery(section) }}
{% elif section.id == 'faq' %}
{{ faq(section) }}
{% elif section.id == 'recipes' %}
{{ recipes(section) }}
{% else %}
{{ body(section) }}
{% endif %}
{% if section.data['elements'] %}
{{ elements(section) }}
{% endif %}
{% endmacro %}

{% macro link_row() %}
{% if cfg.link_items %}
<p align="center">
{% for item in cfg.link_items %}<a href="{{ item.url }}">{{ item.label }}</a>{% if not loop.last %} &bull; {% endif %}{% endfor %}
</p>
{% endif %}
{% endmacro %}
