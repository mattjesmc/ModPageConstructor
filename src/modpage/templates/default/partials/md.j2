{#
  Markdown macros shared by the README and Modrinth targets.
  `target` is "readme" or "modrinth"; GitHub tolerates more raw HTML than
  Modrinth's sanitiser, so a few flourishes are gated on it.
#}

{%- macro link(item) -%}
{% if item.url %}[{{ item.name }}]({{ item.url }}){% else %}{{ item.name }}{% endif %}
{%- endmacro -%}

{%- macro image(src, alt='', width=None) -%}
<img src="{{ asset(src) }}" alt="{{ alt }}"{% if width %} width="{{ width }}"{% endif %}>
{%- endmacro -%}

{%- macro centered(content) -%}
<p align="center">
  {{ content }}
</p>
{%- endmacro -%}

{#- A section opens with its banner image, or a plain heading when the repo
    has not supplied one. The anchor keeps in-page links working either way. -#}
{% macro section_header(section) %}
{% if section.banner %}
<a id="{{ section.id }}"></a>
<p align="center">
  <img src="{{ asset(section.banner) }}" alt="{{ section.title }}"{% if header.section_banner_width %} width="{{ header.section_banner_width }}"{% endif %}>
</p>
{% if header.heading_with_banner %}

### {{ section.title }}
{% endif %}
{% else %}
<a id="{{ section.id }}"></a>

## {{ section.title }}
{% endif %}
{% endmacro %}

{#- One entry of the contents list: a link where the target supports anchors,
    plain text where it does not. -#}
{%- macro toc_entry(entry) -%}
{% if entry.anchor %}[{{ entry.title }}](#{{ entry.anchor }}){% else %}{{ entry.title }}{% endif %}
{%- endmacro -%}

{#- The contents list, rendered between the header and the first section. It
    mirrors a section header (banner or heading) so the page reads as one. -#}
{% macro contents() %}
{% if toc %}

---
{% if toc.banner %}
<a id="{{ toc.id }}"></a>
<p align="center">
  <img src="{{ asset(toc.banner) }}" alt="{{ toc.title or 'Contents' }}"{% if header.section_banner_width %} width="{{ header.section_banner_width }}"{% endif %}>
</p>
{% if toc.title and header.heading_with_banner %}

### {{ toc.title }}
{% endif %}
{% elif toc.title %}
<a id="{{ toc.id }}"></a>

## {{ toc.title }}
{% endif %}
{% if toc.style == 'inline' %}

{# A raw HTML block swallows the Markdown inside it, so the inline row links
   with <a href> rather than [text](#anchor). #}
<p align="center">
  {% for entry in toc.entries %}{% if entry.anchor %}<a href="#{{ entry.anchor }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}{% if not loop.last %} &nbsp;•&nbsp; {% endif %}{% endfor %}
</p>
{% else %}

{% for entry in toc.entries %}
{% if toc.numbered %}{{ loop.index }}.{% else %}-{% endif %} {{ toc_entry(entry) }}
{% endfor %}
{% endif %}
{% endif %}
{% endmacro %}

{% macro page_header() %}
{% if header.banner %}
<p align="center">
  <img src="{{ asset(header.banner) }}" alt="{{ cfg.name }}"{% if header.width %} width="{{ header.width }}"{% endif %}>
</p>
{% endif %}
{% if header.show_title %}

<h1 align="center">{{ cfg.name }}</h1>
{% endif %}
{% if cfg.tagline %}

<p align="center"><i>{{ cfg.tagline }}</i></p>
{% endif %}
{% if badges %}

<p align="center">
{% for badge in badges %}
{% if badge.url %}  <a href="{{ badge.url }}"><img alt="{{ badge.alt }}" src="{{ badge.image }}"></a>
{% else %}  <img alt="{{ badge.alt }}" src="{{ badge.image }}">
{% endif %}
{% endfor %}
</p>
{% endif %}
{% if minecraft.versions or minecraft.loaders or minecraft.environment %}

<p align="center">
  {% if minecraft.loaders %}<b>Loaders:</b> {{ minecraft.loaders | join(', ') }}{% if minecraft.versions or minecraft.environment %} &nbsp;•&nbsp; {% endif %}{% endif %}{% if minecraft.versions %}<b>Minecraft:</b> {{ minecraft.versions | join(', ') }}{% if minecraft.environment %} &nbsp;•&nbsp; {% endif %}{% endif %}{% if minecraft.environment %}<b>Side:</b> {{ minecraft.environment }}{% endif %}

</p>
{% endif %}
{% endmacro %}

{% macro body(section) %}
{% if section.body %}

{{ section.body }}
{% endif %}
{% endmacro %}

{% macro features(section) %}
{{ body(section) }}
{% for item in section.data['items'] %}
{% if item.image %}

<table><tr>
<td width="200"><img src="{{ asset(item.image) }}" alt="{{ item.title }}"></td>
<td><b>{{ item.title }}</b><br>{{ item.description or '' }}</td>
</tr></table>
{% else %}
- **{{ item.title }}**{% if item.description %} — {{ item.description }}{% endif %}

{% endif %}
{% endfor %}
{% endmacro %}

{% macro gallery(section) %}
{{ body(section) }}
{% for img in section.data['images'] %}

<p align="center">
  <img src="{{ asset(img.src) }}" alt="{{ img.alt or img.caption or cfg.name }}"{% if img.width %} width="{{ img.width }}"{% endif %}>
{% if img.caption %}
  <br><sub><i>{{ img.caption }}</i></sub>
{% endif %}
</p>
{% endfor %}
{% endmacro %}

{% macro dep_table(title, items) %}

**{{ title }}**

| Mod | Version | Notes |
| --- | --- | --- |
{% for item in items %}
| {{ link(item) }} | {{ item.version or item.versions or '—' }} | {{ item.note or item.notes or '' }} |
{% endfor %}
{% endmacro %}

{#- Always rendered: an explicit "None" is as useful to a reader as a list. -#}
{% macro dependencies(section) %}
{{ body(section) }}
{% if section.data['required'] or section.data['optional'] or section.data['bundled'] %}
{% if section.data['required'] %}
{{ dep_table('Required', section.data['required']) }}
{% endif %}
{% if section.data['optional'] %}
{{ dep_table('Optional', section.data['optional']) }}
{% endif %}
{% if section.data['bundled'] %}
{{ dep_table('Bundled (no download needed)', section.data['bundled']) }}
{% endif %}
{% elif not section.body %}

{{ section.empty_text }}
{% endif %}
{% endmacro %}

{% macro incompatibilities(section) %}
{{ body(section) }}
{% if section.data['known'] %}

| Mod | Conflict | Workaround |
| --- | --- | --- |
{% for item in section.data['known'] %}
| {{ link(item) }} | {{ item.reason or item.note or '—' }} | {{ item.workaround or '—' }} |
{% endfor %}
{% elif not section.body %}

{{ section.empty_text }}
{% endif %}
{% endmacro %}

{% macro faq(section) %}
{{ body(section) }}
{% for item in section.data['items'] %}
{% if target == 'readme' %}

<details>
<summary><b>{{ item.question }}</b></summary>

{{ item.answer }}

</details>
{% else %}

**{{ item.question }}**

{{ item.answer }}
{% endif %}
{% endfor %}
{% endmacro %}

{#- Recipe cards are pre-rendered images, laid out in a compact grid and
    folded away behind a <details> so they never dominate the page. GitHub and
    Modrinth both support <details>. CurseForge renders no HTML at all in its
    Markdown mode, so it gets a pipe-table grid from plain.j2 instead. -#}
{% macro recipe_grid(section) %}
{% set opts = section.data['options'] %}
{% set columns = opts.get('columns', 3) %}
<table>
{% for row in section.data['images'] | batch(columns) %}
<tr>
{% for image in row %}
<td align="center" width="{{ (100 / columns) | round | int }}%"><img src="{{ asset(image.relative) }}" alt="{{ image.recipe.type_label }} recipe for {{ image.recipe.display }}"><br><sub>{{ image.recipe.display }}{% if image.recipe.type != 'minecraft:crafting_shaped' %} <i>({{ image.recipe.type_label }})</i>{% endif %}</sub></td>
{% endfor %}
</tr>
{% endfor %}
</table>
{% endmacro %}

{% macro recipes(section) %}
{{ body(section) }}
{% set opts = section.data['options'] %}
{% set images = section.data['images'] %}
{% if images %}
{% set collapse = opts.get('collapsed', True) and target in opts.get('collapse_targets', ['readme', 'modrinth']) %}
{% if collapse %}

<details>
<summary><b>{{ opts.get('summary') or (images | length ~ ' recipes -- click to expand') }}</b></summary>

{{ recipe_grid(section) }}

</details>
{% else %}
{{ recipe_grid(section) }}
{% endif %}
{% elif not section.body %}

{{ section.empty_text }}
{% endif %}
{% endmacro %}


{#- ------------------------------------------------------------------------
    Generated elements.

    A generator hands a section a list of dicts and `layout:` decides how they
    are drawn. Keeping the layouts here rather than in the generator is what
    lets one `git.changelog` be a folded release list on GitHub and a pipe
    table on CurseForge, from a single declaration.
    ------------------------------------------------------------------------ -#}

{%- macro cell(text) -%}
{{ (text if text is not none else '') | string | replace('|', '\|') | replace('\n', ' ') }}
{%- endmacro -%}

{%- macro element_title(item) -%}
{% if item.url %}[{{ item.title }}]({{ item.url }}){% else %}{{ item.title }}{% endif %}
{%- endmacro -%}

{%- macro element_line(item) -%}
{% if item.title %}**{{ element_title(item) }}**{% if item.description %} — {% endif %}{% endif %}{{ item.description or '' }}
{%- endmacro -%}

{% macro elements_list(items) %}

{% for item in items %}
- {{ element_line(item) }}
{% for child in item['items'] or [] %}
  - {{ element_line(child) }}
{% endfor %}
{% endfor %}
{% endmacro %}

{% macro elements_definition(items) %}
{% for item in items %}

**{{ element_title(item) }}**{{ ' · <sub>' ~ item.date ~ '</sub>' if item.date else '' }}

{{ item.description or '' }}
{% endfor %}
{% endmacro %}

{% macro elements_cards(items) %}
{% for item in items %}
{% if item.image or item.src %}

<table><tr>
<td width="200"><img src="{{ asset(item.image or item.src) }}" alt="{{ item.title }}"></td>
<td><b>{{ item.title }}</b><br>{{ item.description or '' }}</td>
</tr></table>
{% else %}

**{{ element_title(item) }}**

{{ item.description or '' }}
{% endif %}
{% endfor %}
{% endmacro %}

{#- Markdown has no carousel, so a slider is a gallery here; only a target that
    renders real HTML can make it slide. -#}
{% macro elements_gallery(items) %}
{% for item in items %}

<p align="center">
  <img src="{{ asset(item.image or item.src) }}" alt="{{ item.alt or item.title or cfg.name }}"{% if item.width %} width="{{ item.width }}"{% endif %}>
{% if item.caption or item.description %}
  <br><sub><i>{{ item.caption or item.description }}</i></sub>
{% endif %}
</p>
{% endfor %}
{% endmacro %}

{% macro elements_table(section) %}
{% set columns = section.data['columns'] %}

|{% for column in columns %} {{ column.title }} |{% endfor %}

|{% for column in columns %} --- |{% endfor %}

{% for item in section.data['elements'] %}
|{% for column in columns %} {{ cell(item[column.field]) }} |{% endfor %}

{% endfor %}
{% endmacro %}

{#- One release: a version, when it shipped, and its changes under the heading
    each change was grouped into. Shared by git.changelog and changelog.file,
    which deliberately produce the same shape. -#}
{% macro changelog_release(release) %}

**{{ element_title(release) }}**{% if release.date %} · <sub>{{ release.date }}</sub>{% endif %}

{% if release.body %}
{{ release.body }}
{% endif %}
{% for group in release['groups'] or [] %}
{% if group.title %}

*{{ group.title }}*
{% endif %}

{% for change in group['items'] %}
- {{ change.title }}{{ ' ([`' ~ change.short ~ '`](' ~ change.url ~ '))' if change.url and change.short else '' }}
{% endfor %}
{% endfor %}
{% if not release['groups'] and release.description %}

{{ release.description }}
{% endif %}
{% endmacro %}

{% macro elements_changelog(section) %}
{% for release in section.data['elements'] %}
{{ changelog_release(release) }}
{% endfor %}
{% endmacro %}

{#- Dispatch on the section's layout, optionally folding the whole list away
    the way the recipe grid does. -#}
{% macro elements_body(section) %}
{% if section.layout == 'table' %}
{{ elements_table(section) }}
{% elif section.layout == 'changelog' %}
{{ elements_changelog(section) }}
{% elif section.layout == 'cards' %}
{{ elements_cards(section.data['elements']) }}
{% elif section.layout in ('gallery', 'slider') %}
{{ elements_gallery(section.data['elements']) }}
{% elif section.layout == 'definition' %}
{{ elements_definition(section.data['elements']) }}
{% else %}
{{ elements_list(section.data['elements']) }}
{% endif %}
{% endmacro %}

{% macro elements(section) %}
{% if section.options.get('collapsed') %}

<details>
<summary><b>{{ section.options.get('summary') or (section.data['elements'] | length ~ ' entries -- click to expand') }}</b></summary>
{{ elements_body(section) }}

</details>
{% else %}
{{ elements_body(section) }}
{% endif %}
{% endmacro %}

{#- Dispatch: every section id routes to the macro that knows its shape, then
    any generated elements it carries are drawn by its layout. -#}
{% macro section_body(section) %}
{% if section.id == 'dependencies' %}
{{ dependencies(section) }}
{% elif section.id == 'incompatibilities' %}
{{ incompatibilities(section) }}
{% elif section.id == 'features' %}
{{ features(section) }}
{% elif section.id == 'gallery' %}
{{ gallery(section) }}
{% elif section.id == 'faq' %}
{{ faq(section) }}
{% elif section.id == 'recipes' %}
{{ recipes(section) }}
{% else %}
{{ body(section) }}
{% endif %}
{% if section.data['elements'] %}
{{ elements(section) }}
{% endif %}
{% endmacro %}

{% macro link_row() %}
{% if cfg.link_items %}

<p align="center">
  {% for item in cfg.link_items %}<a href="{{ item.url }}">{{ item.label }}</a>{% if not loop.last %} &nbsp;•&nbsp; {% endif %}{% endfor %}
</p>
{% endif %}
{% endmacro %}

{% macro page(sections) %}
{{ page_header() }}
{{ contents() }}
{% for section in sections %}

---
{{ section_header(section) }}
{{ section_body(section) }}
{% endfor %}
{% if cfg.footer %}

---

{{ cfg.footer }}
{% endif %}
{% endmacro %}
