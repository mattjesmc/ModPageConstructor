{#
  Markdown macros with no raw HTML at all, for CurseForge's Markdown editor.

  CurseForge's description editor has two modes, WYSIWYG and Markdown, and no
  HTML source view. Its Markdown mode escapes inline HTML instead of rendering
  it, so <p align="center">, <img width>, <table>, <details> and <br> all come
  out as literal text -- which is why pasting the Modrinth page there only half
  works. Everything here is plain CommonMark plus pipe tables: images are
  ![alt](url), badges are [![alt](img)](url), grids are tables. The price is
  that nothing can be centred or resized, so pre-scale banners to the width
  you want them shown at.

  The shape-only macros (dependency tables, FAQ, bodies) are already pure
  Markdown in md.j2 and are reused from there.
#}
{% import partials + "/md.j2" as md with context %}

{%- macro img(src, alt='') -%}
![{{ alt | replace('|', '\|') | replace(']', '') }}]({{ asset(src) }})
{%- endmacro -%}

{#- ------------------------------------------------------------------------
    Typed elements.

    An element carrying `type:` is drawn by a template of its own rather than by the section's
    `layout:`: `<template>/elements/<type>.plain.j2`, looked up on the same loader the partials
    are, so `.modpage/templates/<template>/elements/<type>.plain.j2` in a mod's repository wins
    over the packaged one. That is the seam a repo has for saying "this is a socket table" or
    "this is a piece card" without the shared skeleton having to know what either is - the same
    shape the generator registry already has for the data half.

    A type with no template renders as nothing rather than as an error: a page that is missing
    one block is a better answer than a build that stops, and the warning belongs to whoever
    wrote the type. `raw` is packaged, and is the escape hatch the layouts never had.
    ------------------------------------------------------------------------ -#}
{%- macro has_types(items) -%}
{{ 'yes' if (items or []) | selectattr('type', 'defined') | selectattr('type') | list else '' }}
{%- endmacro -%}

{% macro typed(items) %}
{% for item in items or [] %}
{% if item.type %}
{% include [cfg.template ~ '/elements/' ~ item.type ~ '.plain.j2'] ignore missing %}
{% endif %}
{% endfor %}
{% endmacro %}

{%- macro cell(text) -%}
{{ text | replace('|', '\|') | replace('\n', ' ') }}
{%- endmacro -%}

{% macro section_header(section) %}
{% if section.banner %}

{{ img(section.banner, section.title) }}
{% if header.heading_with_banner %}

### {{ section.title }}
{% endif %}
{% else %}

## {{ section.title }}
{% endif %}
{% endmacro %}

{#- No HTML means no anchors, so the entries are plain text: the list still
    tells a reader what the page holds, it just cannot jump them there. -#}
{% macro contents() %}
{% if toc %}

---
{% if toc.banner %}

{{ img(toc.banner, toc.title or 'Contents') }}
{% if toc.title and header.heading_with_banner %}

### {{ toc.title }}
{% endif %}
{% elif toc.title %}

## {{ toc.title }}
{% endif %}
{% if toc.style == 'inline' %}

{% for entry in toc.entries %}{{ md.toc_entry(entry) }}{% if not loop.last %} • {% endif %}{% endfor %}

{% else %}

{% for entry in toc.entries %}
{% if toc.numbered %}{{ loop.index }}.{% else %}-{% endif %} {{ md.toc_entry(entry) }}
{% endfor %}
{% endif %}
{% endif %}
{% endmacro %}

{% macro page_header() %}
{% if header.banner %}
{{ img(header.banner, cfg.name) }}
{% endif %}
{% if header.show_title %}

# {{ cfg.name }}
{% endif %}
{% if cfg.tagline %}

*{{ cfg.tagline }}*
{% endif %}
{% if badges %}

{% for badge in badges %}{% if badge.url %}[![{{ badge.alt }}]({{ badge.image }})]({{ badge.url }}){% else %}![{{ badge.alt }}]({{ badge.image }}){% endif %}{% if not loop.last %} {% endif %}{% endfor %}

{% endif %}
{% if minecraft.loaders or minecraft.versions or minecraft.environment %}

{% if minecraft.loaders %}**Loaders:** {{ minecraft.loaders | join(', ') }}{% if minecraft.versions or minecraft.environment %} • {% endif %}{% endif %}{% if minecraft.versions %}**Minecraft:** {{ minecraft.versions | join(', ') }}{% if minecraft.environment %} • {% endif %}{% endif %}{% if minecraft.environment %}**Side:** {{ minecraft.environment }}{% endif %}

{% endif %}
{% endmacro %}

{% macro link_row() %}
{% if cfg.link_items %}

{% for item in cfg.link_items %}[{{ item.label }}]({{ item.url }}){% if not loop.last %} • {% endif %}{% endfor %}

{% endif %}
{% endmacro %}

{% macro features(section) %}
{{ md.body(section) }}
{% for item in section.data['items'] %}
{% if item.image %}

{{ img(item.image, item.title) }}

**{{ item.title }}**{% if item.description %} — {{ item.description }}{% endif %}

{% else %}
- **{{ item.title }}**{% if item.description %} — {{ item.description }}{% endif %}

{% endif %}
{% endfor %}
{% endmacro %}

{% macro gallery(section) %}
{{ md.body(section) }}
{% for image in section.data['images'] %}

{{ img(image.src, image.alt or image.caption or cfg.name) }}
{% if image.caption %}

*{{ image.caption }}*
{% endif %}
{% endfor %}
{% endmacro %}

{#- A pipe table is the only grid Markdown has. The first row of cards doubles
    as the table header, every image row is followed by its caption row, and
    the column alignment colons centre the cards. Nothing is collapsed:
    CurseForge's Markdown has no <details>. -#}
{% macro recipe_grid(section) %}
{% set columns = section.data['options'].get('columns', 3) %}
{% for row in section.data['images'] | batch(columns) %}
|{% for image in row %} {{ img(image.relative, image.recipe.type_label ~ ' recipe for ' ~ image.recipe.display) }} |{% endfor %}

{% if loop.first %}
|{% for _ in row %} :---: |{% endfor %}

{% endif %}
|{% for image in row %} {{ cell(image.recipe.display) }}{% if image.recipe.type != 'minecraft:crafting_shaped' %} *({{ image.recipe.type_label }})*{% endif %} |{% endfor %}

{% endfor %}
{% endmacro %}

{% macro recipes(section) %}
{{ md.body(section) }}
{% if section.data['images'] %}

{{ recipe_grid(section) }}
{% elif not section.body %}

{{ section.empty_text }}
{% endif %}
{% endmacro %}


{#- Generated elements, with the HTML taken back out. The bullet list and the
    pipe table in md.j2 are already pure Markdown and are reused as they are;
    the layouts that lean on <table>, <sub> or <details> are rewritten here.
    A slider cannot slide without HTML, so it reads as a captioned sequence. -#}

{% macro elements_definition(items) %}
{% for item in items %}

**{% if item.url %}[{{ item.title }}]({{ item.url }}){% else %}{{ item.title }}{% endif %}**{{ ' · ' ~ item.date if item.date else '' }}

{{ item.description or '' }}
{% endfor %}
{% endmacro %}

{% macro elements_cards(items) %}
{% for item in items %}
{% if item.image or item.src %}

{{ img(item.image or item.src, item.title or cfg.name) }}
{% endif %}

**{% if item.url %}[{{ item.title }}]({{ item.url }}){% else %}{{ item.title }}{% endif %}**{% if item.description %} — {{ item.description }}{% endif %}

{% endfor %}
{% endmacro %}

{% macro elements_gallery(items) %}
{% for item in items %}

{{ img(item.image or item.src, item.alt or item.title or cfg.name) }}
{% if item.caption or item.description %}

*{{ item.caption or item.description }}*
{% endif %}
{% endfor %}
{% endmacro %}

{% macro changelog_release(release) %}

**{% if release.url %}[{{ release.title }}]({{ release.url }}){% else %}{{ release.title }}{% endif %}**{% if release.date %} · {{ release.date }}{% endif %}

{% if release.body %}
{{ release.body }}
{% endif %}
{% for group in release['groups'] or [] %}
{% if group.title %}

*{{ group.title }}*
{% endif %}

{% for change in group['items'] %}
- {{ change.title }}{{ ' ([`' ~ change.short ~ '`](' ~ change.url ~ '))' if change.url and change.short else '' }}
{% endfor %}
{% endfor %}
{% if not release['groups'] and release.description %}

{{ release.description }}
{% endif %}
{% endmacro %}

{#- Nothing is folded: CurseForge's Markdown mode has no <details>. -#}
{% macro elements(section) %}
{% if has_types(section.data['elements']) %}
{{ typed(section.data['elements']) }}
{% elif section.layout == 'table' %}
{{ md.elements_table(section) }}
{% elif section.layout == 'changelog' %}
{% for release in section.data['elements'] %}
{{ changelog_release(release) }}
{% endfor %}
{% elif section.layout == 'cards' %}
{{ elements_cards(section.data['elements']) }}
{% elif section.layout in ('gallery', 'slider') %}
{{ elements_gallery(section.data['elements']) }}
{% elif section.layout == 'definition' %}
{{ elements_definition(section.data['elements']) }}
{% else %}
{{ md.elements_list(section.data['elements']) }}
{% endif %}
{% endmacro %}

{% macro section_body(section) %}
{% if section.id == 'dependencies' %}
{{ md.dependencies(section) }}
{% elif section.id == 'incompatibilities' %}
{{ md.incompatibilities(section) }}
{% elif section.id == 'features' %}
{{ features(section) }}
{% elif section.id == 'gallery' %}
{{ gallery(section) }}
{% elif section.id == 'faq' %}
{{ md.faq(section) }}
{% elif section.id == 'recipes' %}
{{ recipes(section) }}
{% else %}
{{ md.body(section) }}
{% endif %}
{% if section.data['elements'] %}
{{ elements(section) }}
{% endif %}
{% endmacro %}
